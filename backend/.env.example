PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taylor_tech
# true quando o banco exigir conexao segura (ex: TiDB Cloud Serverless)
DB_SSL=false

WHATSAPP_NUMERO=5581999999999

# Chave usada para assinar o login (token). Troque por um valor aleatorio em produção.
JWT_SECRET=troque-esta-chave-em-producao

# Chaves VAPID para notificacoes push (Web Push). Gere as suas com:
#   npx web-push generate-vapid-keys
# Sem essas chaves, o botao "Ativar notificações" do painel fica desativado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
